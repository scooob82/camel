{
  "name": "camelapache-studio",
  "version": "0.3.0",
  "private": true,
  "description": "Integration Studio for Apache Camel \u2014 visual route builder (MVP)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "serve": "php -S 127.0.0.1:8080 -t dist scripts/dev-router.php",
    "migrate": "php api/bin/migrate.php",
    "test": "node --import tsx --test src/core/core.test.ts src/core/runner.test.ts src/core/lab/lab.test.ts && node --test scripts/catalog.test.mjs",
    "test:api": "php api/tests/run.php",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:api && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "catalog": "node scripts/generate-catalog.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "playwright": "^1.50.0",
    "prettier": "^3.5.0",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "typescript-eslint": "^8.24.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}
