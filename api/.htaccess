# Studio API — every request goes through index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Never expose source, config, storage, migrations, tests or scripts
  RewriteRule ^(src|storage|migrations|bin|tests)(/|$) - [F,L]
  RewriteRule ^config(\.example)?\.php$ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^(config|config\.example)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
</IfModule>
